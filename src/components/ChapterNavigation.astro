---
import "../styles/global.css";
import ArrowIcon from "./ArrowIcon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import ViewToggle from "./ViewToggle.astro";
import DirectionToggle from "./DirectionToggle.astro";

export interface Props {
  volume: number;
  chapter: {
    number: number;
    title: string;
    pageCount: number;
  };
  prevChapter: number | null;
  nextChapter: number | null;
}

const { volume, chapter, prevChapter, nextChapter } = Astro.props;
---

<nav
  class="fixed top-0 left-0 right-0 bg-white/80 dark:bg-black/80 backdrop-blur-md border-b border-gray-200/50 dark:border-neutral-800/50 z-50 transition-transform duration-300"
  id="navBar"
>
  <div
    class="max-w-7xl flex flex-wrap items-center justify-center md:justify-between mx-auto p-4"
  >
    <div class="flex items-center gap-3 md:gap-4">
      <a href="/">
        <img src="/Vagabond_Logo.webp" alt="Vagabond" class="h-15" />
      </a>

      <div class="flex flex-col gap-0.5">
        <span
          class="bg-gray-100 dark:bg-neutral-900 text-gray-800 dark:text-neutral-200 text-2xs md:text-xs font-medium px-2 py-0.5 rounded uppercase tracking-wide w-fit"
        >
          Ch. {chapter.number}
        </span>
        <span
          class="text-xs md:text-sm font-semibold text-gray-900 dark:text-white"
        >
          {chapter.title}
        </span>
      </div>
    </div>

    <div class="flex items-center gap-2 md:gap-3">
      <span
        class="text-gray-500 dark:text-neutral-400 text-[11px] md:text-sm font-medium whitespace-nowrap uppercase"
      >
        Pg. <span id="pageCounter">1</span> / {chapter.pageCount}
      </span>
      {
        prevChapter !== null ? (
          <a
            href={`/volume-${volume}/chapter-${prevChapter}`}
            class="text-gray-900 dark:text-white bg-white dark:bg-neutral-950 border border-gray-300 dark:border-neutral-700 hover:bg-gray-100 dark:hover:bg-neutral-900 focus:ring-4 focus:ring-gray-100 dark:focus:ring-neutral-800 font-medium rounded-lg text-[11px] md:text-sm px-3 py-1.5 md:px-4 md:py-2 focus:outline-none transition-colors whitespace-nowrap"
          >
            <span class="inline-flex items-center gap-1">
              <ArrowIcon direction="left" class="w-3 h-3" />
              Prev
            </span>
          </a>
        ) : (
          <button
            class="text-gray-400 dark:text-neutral-600 bg-gray-100 dark:bg-neutral-900 border border-gray-200 dark:border-neutral-800 font-medium rounded-lg text-[11px] md:text-sm px-3 py-1.5 md:px-4 md:py-2 cursor-not-allowed whitespace-nowrap"
            disabled
          >
            <span class="inline-flex items-center gap-1">
              <ArrowIcon direction="left" class="w-3 h-3" />
              Prev
            </span>
          </button>
        )
      }
      {
        nextChapter !== null ? (
          <a
            href={`/volume-${volume}/chapter-${nextChapter}`}
            class="text-white dark:text-black bg-black dark:bg-white hover:bg-neutral-900 dark:hover:bg-neutral-200 focus:ring-4 focus:ring-gray-300 dark:focus:ring-neutral-700 font-medium rounded-lg text-[11px] md:text-sm px-3 py-1.5 md:px-4 md:py-2 focus:outline-none transition-colors whitespace-nowrap"
          >
            <span class="inline-flex items-center gap-1">
              Next
              <ArrowIcon direction="right" class="w-3 h-3" />
            </span>
          </a>
        ) : (
          <button
            class="text-gray-400 dark:text-neutral-600 bg-gray-100 dark:bg-neutral-900 border border-gray-200 dark:border-neutral-800 font-medium rounded-lg text-[11px] md:text-sm px-3 py-1.5 md:px-4 md:py-2 cursor-not-allowed whitespace-nowrap"
            disabled
          >
            <span class="inline-flex items-center gap-1">
              Next
              <ArrowIcon direction="right" class="w-3 h-3" />
            </span>
          </button>
        )
      }
      <DirectionToggle />
      <ViewToggle />
      <ThemeToggle />
    </div>
  </div>
</nav>

<script>
  import { currentPage, navbarVisibility } from "../feature/reader/store";

  const navBar = document.getElementById("navBar") as HTMLElement;
  const pageCounter = document.getElementById("pageCounter") as HTMLElement;

  currentPage.subscribe((page) => {
    pageCounter.textContent = `${page + 1}`;
  });

  navbarVisibility.subscribe((visibility) => {
    if (visibility === "visible") {
      navBar.classList.remove("-translate-y-full");
    } else {
      navBar.classList.add("-translate-y-full");
    }
  });
</script>
