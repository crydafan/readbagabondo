---
import MainLayout from "../layouts/MainLayout.astro";
import VolumeCard from "../components/VolumeCard.astro";
import { db, getMangaLibraryCounts, getMangaVolumes } from "@readbagabondo/db";

const { volumeCount, chapterCount } = await getMangaLibraryCounts(db);
const volumes = await getMangaVolumes(db);
---

<MainLayout
  metadata={{
    title: "Read Vagabond Manga",
    description: `Vagabond is a critically acclaimed epic samurai manga written and illustrated by Takehiko Inoue that provides a fictionalized retelling of the life of Japan's legendary swordsman, Miyamoto Musashi. Read all chapters online for free in high-quality scans.`,
    keywords: [
      "Vagabond manga",
      "read Vagabond online",
      "Takehiko Inoue",
      "Miyamoto Musashi",
      "manga reader",
      "free manga",
      "samurai manga",
    ],
  }}
>
  <main class="max-w-275 mx-auto px-4 md:px-6 pt-20">
    <section
      class="pt-12 pb-8 md:pt-24 md:pb-16 md:min-h-[calc(95vh-5rem)] grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-6 md:gap-10 items-center"
    >
      <div>
        <h1 class="text-5xl md:text-6xl leading-[1.05] m-0 mb-4 font-bold">
          Read Takehiko Inoue's masterpiece as intended
        </h1>
        <p class="text-gray-500 dark:text-neutral-400 text-xl max-w-[52ch]">
          High-quality scans of all chapters. Free forever.
        </p>
        <div class="flex items-center gap-3 mt-3">
          <img
            src="https://keiyoushi.github.io/favicon.ico"
            alt="Keiyoushi Logo"
            width="35"
          />
          <a
            class="text-lg tracking-tight font-semibold animate-gradient"
            target="_blank"
            rel="noopener noreferrer"
            href="https://keiyoushi.github.io/extensions/#en.readvagabondmanga"
          >
            Now available via Keiyoushi extensions!
          </a>
        </div>
        <div
          class="flex flex-col md:flex-row gap-3 mt-7 flex-wrap w-full md:w-auto"
        >
          <a
            href="#volumes"
            class="text-white dark:text-black bg-black dark:bg-white hover:bg-neutral-900 dark:hover:bg-neutral-200 focus:ring-4 focus:ring-gray-300 dark:focus:ring-neutral-700 font-medium rounded-lg text-base px-6 py-3 text-center w-full md:w-auto focus:outline-none"
          >
            Read Now
          </a>
          <a
            href="#donate"
            class="text-gray-900 dark:text-white bg-white dark:bg-neutral-950 border border-gray-300 dark:border-neutral-700 hover:bg-gray-100 dark:hover:bg-neutral-900 focus:ring-4 focus:ring-gray-100 dark:focus:ring-neutral-800 font-medium rounded-lg text-base px-6 py-3 text-center w-full md:w-auto focus:outline-none"
          >
            Donate
          </a>
        </div>
      </div>
      <img
        id="hero"
        class="w-full md:max-w-100 lg:max-w-full mx-auto"
        fetchpriority="high"
      />
    </section>

    <section id="volumes" class="py-10 md:py-16 scroll-mt-20">
      <h2
        class="text-center mb-4 text-3xl font-bold text-gray-900 dark:text-white"
      >
        Volumes
      </h2>
      <div class="flex justify-center gap-2 mb-8">
        <span
          class="bg-gray-100 dark:bg-neutral-900 text-gray-800 dark:text-neutral-200 text-sm font-medium px-3 py-1 rounded"
          >{volumeCount} volumes</span
        >
        <span
          class="bg-gray-100 dark:bg-neutral-900 text-gray-800 dark:text-neutral-200 text-sm font-medium px-3 py-1 rounded"
          >{chapterCount} chapters</span
        >
      </div>
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 max-w-7xl mx-auto"
      >
        {
          volumes.map((volume) => (
            <VolumeCard
              volume={volume.number}
              chapterCount={volume.chapterCount}
              releaseDate={volume.releaseDate}
              firstChapter={volume.firstChapter ?? 0}
              lastChapter={volume.lastChapter ?? 0}
            />
          ))
        }
      </div>
    </section>

    <section id="donate" class="py-10 md:py-16">
      <div
        class="block p-6 bg-white dark:bg-neutral-950 border border-gray-200 dark:border-neutral-800 rounded-lg shadow"
      >
        <h5
          class="mb-2 text-xl md:text-2xl font-bold tracking-tight text-gray-900 dark:text-white"
        >
          Support This Project
        </h5>
        <p class="mb-4 text-gray-700 dark:text-neutral-300">
          If you enjoy this reader and want to support its development, consider
          buying me a coffee! Your donations help keep this project
          high-quality, free and ad-free for everyone.
        </p>
        <div class="flex flex-col md:flex-row gap-3">
          <a
            href="https://www.paypal.com/paypalme/mdnssknght"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 text-white dark:text-black bg-black dark:bg-white hover:bg-neutral-900 dark:hover:bg-neutral-200 focus:ring-4 focus:ring-gray-300 dark:focus:ring-neutral-700 font-medium rounded-lg text-sm px-5 py-2.5 text-center w-full md:w-auto focus:outline-none"
          >
            Donate via PayPal
            <i class="fab fa-paypal"></i>
          </a>
          <a
            href="https://ko-fi.com/crydafan"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 text-gray-900 dark:text-white bg-white dark:bg-neutral-950 border border-gray-300 dark:border-neutral-700 hover:bg-gray-100 dark:hover:bg-neutral-900 focus:ring-4 focus:ring-gray-100 dark:focus:ring-neutral-800 font-medium rounded-lg text-sm px-5 py-2.5 text-center w-full md:w-auto focus:outline-none"
          >
            Support me on Ko-fi
            <i class="fa fa-coffee"></i>
          </a>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<script>
  const hero = document.getElementById("hero") as HTMLImageElement | null;

  const syncHero = () => {
    if (!hero) return;

    const isDark = document.documentElement.classList.contains("dark");
    hero.src = isDark ? "/Musashi_Pray.webp" : "/Musashi_Eating.webp";
    hero.alt = isDark ? "Musashi Praying" : "Musashi Eating";
  };

  syncHero();

  new MutationObserver(syncHero).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["class"],
  });

  document.addEventListener("click", (e) => {
    const target = e.target;
    if (!(target instanceof Element)) return;

    const link = target.closest("a");
    if (!link || !link.hash) return;

    const isSamePage =
      link.origin === window.location.origin &&
      link.pathname === window.location.pathname;
    if (!isSamePage) return;

    e.preventDefault();

    const targetElement = document.querySelector(link.hash);
    targetElement?.scrollIntoView({ behavior: "smooth" });
  });
</script>
